<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>WPF_Premium</PackageId>
    <Version>1.0.0</Version>
    <Authors>WPF Premium</Authors>
    <Description>Thư viện điều khiển, biểu đồ và giao diện WPF có thể tái sử dụng và tùy biến.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>wpf;ui;controls;theme;avalondock;docking;charts;dataviz</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="MahApps.Metro.IconPacks" Version="6.2.1" />
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.2" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
