<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>WPF_Premium</PackageId>
    <Version>1.0.0</Version>
    <Authors>WPF Premium</Authors>
    <Description>Thư viện điều khiển, biểu đồ và giao diện WPF có thể tái sử dụng và tùy biến.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>wpf;ui;controls;theme;avalondock;docking;charts;dataviz</PackageTags>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WPF_Premium.Core\WPF_Premium.Core.csproj" />
    <ProjectReference Include="..\WPF_Premium.Charts\WPF_Premium.Charts.csproj" />
    <ProjectReference Include="..\WPF_Premium.Media\WPF_Premium.Media.csproj" />
    <ProjectReference Include="..\WPF_Premium.Documents\WPF_Premium.Documents.csproj" />
    <ProjectReference Include="..\WPF_Premium.Maps\WPF_Premium.Maps.csproj" />
    <Compile Include="TypeForwarders.cs" />
    <Page Include="..\WPF_Premium\Themes\WpfPremium.xaml" Link="Themes\WpfPremium.xaml" />
    <Page Include="..\WPF_Premium\Themes\WpfPremiumAvalonDock.xaml" Link="Themes\WpfPremiumAvalonDock.xaml" />
    <Page Include="..\WPF_Premium\Themes\WpfPremiumDark.xaml" Link="Themes\WpfPremiumDark.xaml" />
    <Page Include="..\WPF_Premium\Resources\AvalonDock.en.xaml" Link="Resources\AvalonDock.en.xaml" />
    <Page Include="..\WPF_Premium\Resources\AvalonDock.vi.xaml" Link="Resources\AvalonDock.vi.xaml" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
