<UserControl x:Class="WPF_Premium.Controls.FormattedInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="28">
    <Grid>
        <TextBox x:Name="PART_Input" Style="{StaticResource Input}"
                 TextChanged="Input_TextChanged" PreviewTextInput="Input_PreviewTextInput"
                 PreviewKeyDown="Input_PreviewKeyDown" />
        <TextBlock x:Name="PlaceholderText" Margin="9,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
</UserControl>
