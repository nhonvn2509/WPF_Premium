<UserControl x:Class="WPF_Premium.Controls.DateTimeRangeCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WPF_Premium.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             MinWidth="220"
             HorizontalAlignment="Left"
             Height="34">
    <Grid>
        <ToggleButton x:Name="RangeToggle"
                      Click="RangeToggle_Click"
                      AutomationProperties.AutomationId="DateRangePickerOpenButton"
                      AutomationProperties.Name="Chọn khoảng thời gian"
                      Style="{StaticResource ComboBoxToggle}">
            <Grid>
                <TextBlock Text="{Binding DisplayText, RelativeSource={RelativeSource AncestorType={x:Type controls:DateTimeRangeCalendar}}}"
                           AutomationProperties.AutomationId="DateRangeSummary"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="29,0,28,0" />
                <iconPacks:PackIconMaterial Kind="CalendarRange"
                                            Width="14" Height="14"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="9,0,0,0"
                                            Foreground="{DynamicResource MutedForegroundBrush}" />
                <iconPacks:PackIconMaterial Kind="ChevronDown"
                                            Width="14" Height="14"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,9,0"
                                            Foreground="{DynamicResource MutedForegroundBrush}" />
            </Grid>
        </ToggleButton>
        <Popup x:Name="RangePopup"
               AutomationProperties.AutomationId="DateRangePopup"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=RangeToggle}"
               StaysOpen="False"
               Closed="RangePopup_Closed">
            <Border Width="590"
                    MaxHeight="680"
                    Background="{DynamicResource PopoverBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="{DynamicResource WpfPremium.SurfaceBorderThickness}"
                    CornerRadius="{DynamicResource WpfPremium.SurfaceCornerRadius}"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="KHOẢNG THỜI GIAN"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="2,0,0,10" />
                    <WrapPanel x:Name="PresetPanel" Margin="0,0,0,10">
                        <Button Content="Hôm qua" Tag="Yesterday" Click="Preset_Click"
                                AutomationProperties.AutomationId="DateRangePresetYesterday"
                                Style="{StaticResource ButtonOutline}" Margin="0,0,6,0" />
                        <Button Content="Hôm nay" Tag="Today" Click="Preset_Click"
                                AutomationProperties.AutomationId="DateRangePresetToday"
                                Style="{StaticResource ButtonOutline}" Margin="0,0,6,0" />
                        <Button Content="7 ngày qua" Tag="Last7Days" Click="Preset_Click"
                                AutomationProperties.AutomationId="DateRangePresetLast7Days"
                                Style="{StaticResource ButtonOutline}" Margin="0,0,6,0" />
                        <Button Content="30 ngày qua" Tag="Last30Days" Click="Preset_Click"
                                AutomationProperties.AutomationId="DateRangePresetLast30Days"
                                Style="{StaticResource ButtonOutline}" Margin="0,0,6,0" />
                        <Button Content="Tùy chỉnh" Tag="Custom" Click="Preset_Click"
                                AutomationProperties.AutomationId="DateRangePresetCustom"
                                Style="{StaticResource ButtonOutline}" />
                    </WrapPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <Button Click="PreviousMonth_Click"
                                AutomationProperties.AutomationId="DateRangePreviousMonth"
                                AutomationProperties.Name="Tháng trước"
                                Style="{StaticResource ButtonGhost}"
                                Padding="0" MinHeight="28">
                            <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="14" Height="14" />
                        </Button>
                        <Button Grid.Column="2" Click="NextMonth_Click"
                                AutomationProperties.AutomationId="DateRangeNextMonth"
                                AutomationProperties.Name="Tháng sau"
                                Style="{StaticResource ButtonGhost}"
                                Padding="0" MinHeight="28">
                            <iconPacks:PackIconMaterial Kind="ChevronRight" Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:CalendarControl x:Name="FirstCalendar"
                                                  Grid.Column="0"
                                                  AutomationIdPrefix="DateRangeDay"
                                                  Width="272"
                                                  SelectionMode="Range"
                                                  ShowNavigationButtons="False"
                                                  RangeSelectionChanged="RangeCalendar_RangeSelectionChanged" />
                        <controls:CalendarControl x:Name="SecondCalendar"
                                                  Grid.Column="2"
                                                  AutomationIdPrefix="DateRangeDay"
                                                  Width="272"
                                                  SelectionMode="Range"
                                                  ShowNavigationButtons="False"
                                                  RangeSelectionChanged="RangeCalendar_RangeSelectionChanged" />
                    </Grid>
                    <Separator Style="{StaticResource Marker}" Margin="0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BẮT ĐẦU" FontSize="10"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                            <TextBlock x:Name="StartDateLabel"
                                       AutomationProperties.AutomationId="DateRangePendingStartDate"
                                       FontSize="12"
                                       FontWeight="Medium" Margin="0,3,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <controls:ComboBoxControl x:Name="StartHour" Width="64" MinWidth="0"
                                                          Height="32" SearchEnabled="False" Placeholder="hh" />
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" />
                                <controls:ComboBoxControl x:Name="StartMinute" Width="64" MinWidth="0"
                                                          Height="32" SearchEnabled="False" Placeholder="mm" />
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" />
                                <controls:ComboBoxControl x:Name="StartSecond" Width="64" MinWidth="0"
                                                          Height="32" SearchEnabled="False" Placeholder="ss" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="KẾT THÚC" FontSize="10"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                            <TextBlock x:Name="EndDateLabel"
                                       AutomationProperties.AutomationId="DateRangePendingEndDate"
                                       FontSize="12"
                                       FontWeight="Medium" Margin="0,3,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <controls:ComboBoxControl x:Name="EndHour" Width="64" MinWidth="0"
                                                          Height="32" SearchEnabled="False" Placeholder="hh" />
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" />
                                <controls:ComboBoxControl x:Name="EndMinute" Width="64" MinWidth="0"
                                                          Height="32" SearchEnabled="False" Placeholder="mm" />
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" />
                                <controls:ComboBoxControl x:Name="EndSecond" Width="64" MinWidth="0"
                                                          Height="32" SearchEnabled="False" Placeholder="ss" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ValidationText"
                               AutomationProperties.AutomationId="DateRangeValidationMessage"
                               Foreground="{DynamicResource DestructiveBrush}"
                               FontSize="11"
                               Margin="0,8,0,0"
                               Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <Button Content="Xóa" Click="Clear_Click"
                                AutomationProperties.AutomationId="DateRangeClearButton"
                                Style="{StaticResource ButtonGhost}" />
                        <Button Content="Hủy" Click="Cancel_Click"
                                AutomationProperties.AutomationId="DateRangeCancelButton"
                                Style="{StaticResource ButtonOutline}" Margin="6,0,0,0" />
                        <Button Content="Áp dụng" Click="Apply_Click"
                                AutomationProperties.AutomationId="DateRangeApplyButton"
                                Style="{StaticResource ButtonPrimary}" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
