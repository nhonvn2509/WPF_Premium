<UserControl x:Class="WPF_Premium.Controls.MultiSelectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WPF_Premium.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             MinWidth="180"
             Height="34">
    <Grid>
        <ToggleButton x:Name="MultiSelectToggle"
                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType={x:Type controls:MultiSelectControl}}, Mode=TwoWay}"
                      Style="{StaticResource ComboBoxToggle}">
            <Grid>
                <TextBlock Text="{Binding DisplayText, RelativeSource={RelativeSource AncestorType={x:Type controls:MultiSelectControl}}}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="9,0,28,0">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItems.Count, RelativeSource={RelativeSource AncestorType={x:Type controls:MultiSelectControl}}}"
                                             Value="0">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <iconPacks:PackIconMaterial Kind="ChevronDown"
                                            Width="14"
                                            Height="14"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,9,0"
                                            Foreground="{DynamicResource MutedForegroundBrush}" />
            </Grid>
        </ToggleButton>
        <Popup x:Name="MultiSelectPopup"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=MultiSelectToggle}"
               StaysOpen="False"
               PopupAnimation="Fade"
               Opened="MultiSelectPopup_Opened"
               Closed="MultiSelectPopup_Closed">
            <Border Width="{Binding ActualWidth, ElementName=MultiSelectToggle}"
                    MaxHeight="300"
                    Background="{DynamicResource PopoverBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="{DynamicResource WpfPremium.SurfaceBorderThickness}"
                    CornerRadius="{DynamicResource WpfPremium.SurfaceCornerRadius}"
                    Padding="4">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2,2,2,6">
                    <Button Content="Xóa lựa chọn"
                                DockPanel.Dock="Right"
                                Click="ClearSelection_Click"
                                Style="{StaticResource ButtonLink}"
                                Margin="8,0,0,0" />
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding SearchEnabled, Converter={StaticResource WpfPremiumBooleanToVisibilityConverter}}"
                                 Padding="6,3"
                                 MinHeight="28"
                                 ToolTip="Nhập để lọc các lựa chọn" />
                    </DockPanel>
                    <Grid>
                        <ListBox x:Name="ItemsList"
                                 ItemsSource="{Binding FilteredItems}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="ItemsList_SelectionChanged"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MaxHeight="240" />
                        <TextBlock Text="{Binding NoResultsText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilteredItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
