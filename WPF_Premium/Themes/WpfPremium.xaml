<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:WPF_Premium.Controls"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/WPF_Premium.Core;component/Themes/WpfPremiumAvalonDock.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FF09090B" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PopoverBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FFF4F4F5" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#FF71717A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFE4E4E7" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF18181B" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#FFF4F4F5" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#FF18181B" />
    <SolidColorBrush x:Key="DestructiveBrush" Color="#FFDC2626" />
    <SolidColorBrush x:Key="DestructiveForegroundBrush" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF16A34A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFCA8A04" />
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="#FF18181B" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FF18181B" />
    <SolidColorBrush x:Key="TraceActiveBrush" Color="#FF2563EB" />
    <SolidColorBrush x:Key="SelectedTabBrush" Color="#FFE0E7FF" />
    <SolidColorBrush x:Key="ChartColor1Brush" Color="#FF18181B" />
    <SolidColorBrush x:Key="ChartColor2Brush" Color="#FF2563EB" />
    <SolidColorBrush x:Key="ChartColor3Brush" Color="#FF16A34A" />
    <SolidColorBrush x:Key="ChartColor4Brush" Color="#FFCA8A04" />
    <SolidColorBrush x:Key="ChartColor5Brush" Color="#FFDC2626" />
    <SolidColorBrush x:Key="ChartColor6Brush" Color="#FF7C3AED" />
    <SolidColorBrush x:Key="ChartColor7Brush" Color="#FF0891B2" />
    <SolidColorBrush x:Key="ChartColor8Brush" Color="#FFDB2777" />
    <SolidColorBrush x:Key="ChartColor9Brush" Color="#FFEA580C" />
    <SolidColorBrush x:Key="ChartColor10Brush" Color="#FF65A30D" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#FFD4D4D8" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#FFA1A1AA" />
    <BooleanToVisibilityConverter x:Key="WpfPremiumBooleanToVisibilityConverter" />

    <FontFamily x:Key="WpfPremium.FontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="WpfPremium.FontSize">13</sys:Double>
    <sys:Double x:Key="WpfPremium.SmallFontSize">11</sys:Double>
    <sys:Double x:Key="WpfPremium.Heading1FontSize">26</sys:Double>
    <sys:Double x:Key="WpfPremium.Heading2FontSize">22</sys:Double>
    <sys:Double x:Key="WpfPremium.Heading3FontSize">18</sys:Double>
    <sys:Double x:Key="WpfPremium.ControlMinHeight">28</sys:Double>
    <Thickness x:Key="WpfPremium.ControlPadding">7,4</Thickness>
    <CornerRadius x:Key="WpfPremium.ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="WpfPremium.SplitButtonMainCornerRadius">4,0,0,4</CornerRadius>
    <CornerRadius x:Key="WpfPremium.SplitButtonArrowCornerRadius">0,4,4,0</CornerRadius>
    <sys:Double x:Key="WpfPremium.IconSize">12</sys:Double>
    <sys:Double x:Key="WpfPremium.CheckBoxSize">14</sys:Double>
    <sys:Double x:Key="WpfPremium.SwitchWidth">38</sys:Double>
    <sys:Double x:Key="WpfPremium.SwitchHeight">20</sys:Double>
    <CornerRadius x:Key="WpfPremium.SwitchCornerRadius">10</CornerRadius>
    <sys:Double x:Key="WpfPremium.SwitchThumbSize">14</sys:Double>
    <sys:Double x:Key="WpfPremium.TableRowHeight">30</sys:Double>
    <CornerRadius x:Key="WpfPremium.SurfaceCornerRadius">8</CornerRadius>
    <Thickness x:Key="WpfPremium.ControlBorderThickness">1</Thickness>
    <Thickness x:Key="WpfPremium.SurfaceBorderThickness">1</Thickness>
    <FontWeight x:Key="WpfPremium.FontWeight">Normal</FontWeight>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource WpfPremium.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource WpfPremium.FontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource WpfPremium.FontWeight}" />
    </Style>

    <Style TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Width" Value="{DynamicResource WpfPremium.IconSize}" />
        <Setter Property="Height" Value="{DynamicResource WpfPremium.IconSize}" />
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PART_DecreaseRepeatButton" Command="{x:Static ScrollBar.PageUpCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb" MinHeight="24" MinWidth="24">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbBorder"
                                                    Margin="2"
                                                    Background="{DynamicResource ScrollBarThumbBrush}"
                                                    CornerRadius="{DynamicResource WpfPremium.ControlCornerRadius}"
                                                    Opacity="0.72"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="1" Duration="0:0:0.12" />
                                                                <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                                 Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                                 To="1.12" Duration="0:0:0.12" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0.72" Duration="0:0:0.14" />
                                                                <DoubleAnimation Storyboard.TargetName="ThumbBorder"
                                                                                 Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                                 To="1" Duration="0:0:0.14" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PART_IncreaseRepeatButton" Command="{x:Static ScrollBar.PageDownCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="10" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="PART_DecreaseRepeatButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                            <Setter TargetName="PART_IncreaseRepeatButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="10" />
                            <Setter Property="Height" Value="Auto" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCaptionButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="40" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="CaptionButtonBorder" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CaptionButtonBorder" Property="Background" Value="{DynamicResource MutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CaptionButtonBorder" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="WindowCloseButton" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CaptionButtonBorder" Property="Background" Value="{DynamicResource DestructiveBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CaptionButtonBorder" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="WindowCloseCaptionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowCaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DestructiveBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DestructiveForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type controls:PremiumWindow}">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource WpfPremium.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource WpfPremium.FontSize}" />
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0"
                                    GlassFrameThickness="0" UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PremiumWindow}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0"
                            SnapsToDevicePixels="True">
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="PART_TitleBar" Grid.Row="0"
                                  Background="{DynamicResource CardBrush}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,8,0">
                                    <Border Width="20" Height="20" CornerRadius="5"
                                            Background="{DynamicResource PrimaryBrush}" Margin="0,0,9,0">
                                        <iconPacks:PackIconMaterial Kind="ApplicationOutline" Width="13" Height="13"
                                                                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                                    <Button x:Name="PART_MinimizeButton" Style="{StaticResource WindowCaptionButton}"
                                            AutomationProperties.Name="Thu nhỏ" ToolTip="Thu nhỏ">
                                        <iconPacks:PackIconMaterial Kind="WindowMinimize" Width="13" Height="13" />
                                    </Button>
                                    <Button x:Name="PART_MaximizeButton" Style="{StaticResource WindowCaptionButton}"
                                            AutomationProperties.Name="Phóng to hoặc khôi phục" ToolTip="Phóng to hoặc khôi phục">
                                        <iconPacks:PackIconMaterial x:Name="PART_MaximizeIcon" Kind="WindowMaximize" Width="13" Height="13" />
                                    </Button>
                                    <Button x:Name="PART_CloseButton" Style="{StaticResource WindowCloseCaptionButton}"
                                            Tag="WindowCloseButton"
                                            AutomationProperties.Name="Đóng cửa sổ" ToolTip="Đóng">
                                        <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ContentPresenter Grid.Row="1" ContentSource="Content"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="ButtonBaseStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource WpfPremium.ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource WpfPremium.ControlPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource WpfPremium.ControlMinHeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource WpfPremium.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource WpfPremium.FontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource WpfPremium.FontWeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource WpfPremium.ControlCornerRadius}"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                          <Trigger Property="Tag" Value="SplitButtonMain">
                              <Setter TargetName="ButtonBorder" Property="CornerRadius" Value="{DynamicResource WpfPremium.SplitButtonMainCornerRadius}" />
                          </Trigger>
                          <Trigger Property="Tag" Value="SplitButtonArrow">
                              <Setter TargetName="ButtonBorder" Property="CornerRadius" Value="{DynamicResource WpfPremium.SplitButtonArrowCornerRadius}" />
                          </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="1.015" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="1.015" Duration="0:0:0.1">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="0.985" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="0.985" Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="1.015" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="1.015" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBaseStyle}" />
    <Style x:Key="Button" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}" />
    <Style x:Key="ButtonPrimary" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBaseStyle}" />
    <Style x:Key="ButtonSecondary" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}" />
    </Style>
    <Style x:Key="ButtonOutline" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style x:Key="ButtonGhost" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style x:Key="ButtonDestructive" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource DestructiveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DestructiveForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DestructiveBrush}" />
    </Style>
    <Style x:Key="ButtonLink" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style x:Key="WpfPremium.ButtonPrimary" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonPrimary}" />
    <Style x:Key="WpfPremium.ButtonSecondary" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonSecondary}" />
    <Style x:Key="WpfPremium.ButtonOutline" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonOutline}" />
    <Style x:Key="WpfPremium.ButtonGhost" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonGhost}" />
    <Style x:Key="WpfPremium.ButtonDestructive" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonDestructive}" />

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource WpfPremium.ControlBorderThickness}" />
        <Setter Property="Padding" Value="{DynamicResource WpfPremium.ControlPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource WpfPremium.ControlMinHeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource WpfPremium.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource WpfPremium.FontSize}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                                <Border x:Name="InputBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{DynamicResource WpfPremium.ControlCornerRadius}"
                                        ClipToBounds="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <TextBlock x:Name="PlaceholderText"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                            <Border x:Name="FocusOverlay"
                                    BorderBrush="{DynamicResource FocusBrush}"
                                    BorderThickness="{DynamicResource WpfPremium.ControlBorderThickness}"
                                    CornerRadius="{DynamicResource WpfPremium.ControlCornerRadius}"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusOverlay"
                                                         Storyboard.TargetProperty="Opacity"
