    <Style x:Key="Table" TargetType="{x:Type controls:Table}" BasedOn="{StaticResource TableBase}" />
    <Style TargetType="{x:Type controls:Table}" BasedOn="{StaticResource Table}" />
    <Style x:Key="WpfPremium.Table" TargetType="{x:Type controls:Table}" BasedOn="{StaticResource Table}" />
    <Style x:Key="WpfPremium.TableBase" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource TableBase}" />
