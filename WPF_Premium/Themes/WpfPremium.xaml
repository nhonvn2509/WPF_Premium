    <Style x:Key="StepBar" TargetType="{x:Type controls:StepBar}">
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type controls:StepBar}" BasedOn="{StaticResource StepBar}" />
    <Style x:Key="StepBarItem" TargetType="{x:Type controls:StepBarItem}">
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StepBarItem}">
                    <Grid MinHeight="58">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="LeftConnector"
                                Grid.Column="0"
                                Height="2"
                                Margin="0,13,0,0"
                                VerticalAlignment="Top"
                                Background="{DynamicResource BorderBrush}" />
                        <Border x:Name="RightConnector"
                                Grid.Column="2"
                                Height="2"
                                Margin="0,13,0,0"
                                VerticalAlignment="Top"
                                Background="{DynamicResource BorderBrush}" />
                        <Border x:Name="Marker"
                                Grid.Column="1"
                                Width="28"
                                Height="28"
                                CornerRadius="14"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Background="{DynamicResource MutedBrush}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <TextBlock x:Name="MarkerLabel"
                                       Text="{TemplateBinding MarkerText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource WpfPremium.SmallFontSize}"
                                       FontWeight="SemiBold" />
                        </Border>
                        <ContentPresenter Grid.Row="1"
                                          Grid.ColumnSpan="3"
                                          Margin="0,6,0,0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Top"
                                          TextBlock.TextAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFirst" Value="True">
                            <Setter TargetName="LeftConnector" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsLast" Value="True">
                            <Setter TargetName="RightConnector" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static controls:StepState.Current}">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Marker" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="Marker" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="LeftConnector" Property="Background" Value="{DynamicResource SuccessBrush}" />
                            <Setter TargetName="MarkerLabel" Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Marker"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         From="0.82" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.2" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Marker"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         From="0.82" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.2" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static controls:StepState.Complete}">
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                            <Setter TargetName="Marker" Property="Background" Value="{DynamicResource SuccessBrush}" />
                            <Setter TargetName="Marker" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                            <Setter TargetName="RightConnector" Property="Background" Value="{DynamicResource SuccessBrush}" />
                            <Setter TargetName="MarkerLabel" Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Marker"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         From="0.9" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Marker"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         From="0.9" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type controls:StepBarItem}" BasedOn="{StaticResource StepBarItem}" />

