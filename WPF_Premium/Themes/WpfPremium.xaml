    <Style x:Key="Field" TargetType="{x:Type controls:Field}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Field}">
                    <StackPanel>
                        <Grid Margin="0,4,0,0">
                            <Border x:Name="FieldFrame"
                                    Margin="0,6,0,0"
                                    Padding="8,8"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="{DynamicResource WpfPremium.SurfaceBorderThickness}"
                                    CornerRadius="{DynamicResource WpfPremium.SurfaceCornerRadius}">
                                <ContentPresenter ContentSource="Content" />
                            </Border>
                            <Border x:Name="FieldLegend"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="10,0,0,0"
                                    Padding="4,0"
                                    Background="{DynamicResource CardBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FieldLabel"
                                               Text="{TemplateBinding Label}"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               FontWeight="Medium"
                                               FontSize="12" />
                                    <TextBlock x:Name="RequiredMark"
                                               Text=" *"
                                               Foreground="{DynamicResource DestructiveBrush}"
                                               Visibility="Collapsed" />
                                    <TextBlock x:Name="FieldError"
                                               Text="{TemplateBinding DisplayError}"
                                               Foreground="{DynamicResource DestructiveBrush}"
                                               FontWeight="Medium"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="FieldDescription" Text="{TemplateBinding Description}"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsRequired" Value="True">
                            <Setter TargetName="RequiredMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="FieldLabel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RequiredMark" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Label" Value="">
                            <Setter TargetName="FieldLabel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RequiredMark" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="FieldDescription" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="FieldDescription" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasError, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="FieldFrame" Property="BorderBrush" Value="{DynamicResource DestructiveBrush}" />
                            <Setter TargetName="FieldLabel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RequiredMark" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FieldError" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FieldDescription" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Description, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                            <Setter TargetName="FieldDescription" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Description, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                            <Setter TargetName="FieldDescription" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
