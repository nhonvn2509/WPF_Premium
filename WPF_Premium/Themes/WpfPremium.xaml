    <Style x:Key="Trace" TargetType="{x:Type ItemsControl}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type controls:TraceEntry}">
                    <StackPanel Margin="0,0,0,2">
                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0"
                                      HorizontalContentAlignment="Stretch"
                                      FocusVisualStyle="{x:Null}"
                                      AutomationProperties.Name="{Binding Title}"
                                      AutomationProperties.HelpText="{Binding Status}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="TraceHeader"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource WpfPremium.ControlCornerRadius}"
                                            Padding="2">
                                        <Grid MinHeight="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="14" />
                                            </Grid.ColumnDefinitions>
                                            <iconPacks:PackIconMaterial x:Name="TraceIcon"
                                                                        Kind="{Binding DisplayIcon}"
                                                                        Width="14"
                                                                        Height="14"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource MutedForegroundBrush}" />
                                            <TextBlock x:Name="TraceTitle"
                                                       Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="12"
                                                       Margin="2,0,0,0" />
                                            <TextBlock x:Name="TraceStatus"
                                                       Grid.Column="2"
                                                       Text="{Binding Status}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       FontSize="11"
                                                       Margin="10,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Duration}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       FontSize="11"
                                                       Margin="10,0,0,0" />
                                            <StackPanel x:Name="TraceDiffStats"
                                                        Grid.Column="4"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="10,0,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="{x:Type StackPanel}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding AddedLines}" Value="{x:Null}" />
                                                                    <Condition Binding="{Binding RemovedLines}" Value="{x:Null}" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="{x:Type StackPanel}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AddedLines}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="+" Foreground="{DynamicResource SuccessBrush}" />
                                                    <TextBlock Text="{Binding AddedLines}" Foreground="{DynamicResource SuccessBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="3,0,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="{x:Type StackPanel}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RemovedLines}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="-" Foreground="{DynamicResource DestructiveBrush}" />
                                                    <TextBlock Text="{Binding RemovedLines}" Foreground="{DynamicResource DestructiveBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <iconPacks:PackIconMaterial x:Name="TraceChevron"
                                                                        Grid.Column="5"
                                                                        Kind="ChevronRight"
                                                                        Width="12"
                                                                        Height="12"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Right"
                                                                        Foreground="{DynamicResource MutedForegroundBrush}">
                                                <iconPacks:PackIconMaterial.Style>
                                                    <Style TargetType="{x:Type iconPacks:PackIconMaterial}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </iconPacks:PackIconMaterial.Style>
                                            </iconPacks:PackIconMaterial>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TraceHeader" Property="Background" Value="{DynamicResource MutedBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="TraceHeader" Property="Background" Value="{DynamicResource MutedBrush}" />
                                            <Setter TargetName="TraceHeader" Property="BorderBrush" Value="{DynamicResource TraceActiveBrush}" />
                                            <Setter TargetName="TraceIcon" Property="Foreground" Value="{DynamicResource TraceActiveBrush}" />
                                            <Setter TargetName="TraceTitle" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="TraceStatus" Property="Foreground" Value="{DynamicResource TraceActiveBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter TargetName="TraceChevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter TargetName="TraceIcon" Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
                                            <Setter TargetName="TraceTitle" Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
                                            <Setter TargetName="TraceStatus" Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid Margin="20,3,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="1"
                                    Background="{DynamicResource BorderBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="3,0,0,0" />
                            <StackPanel Grid.Column="1">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Background="{DynamicResource CardBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource WpfPremium.SurfaceCornerRadius}"
                                        Padding="7"
                                        Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource TraceActiveBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               FontSize="12" />
                                </Border>
                                <Border Background="{DynamicResource MutedBrush}"
                                        CornerRadius="{DynamicResource WpfPremium.SurfaceCornerRadius}"
                                        Padding="10"
                                        Margin="0,2,0,6">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Command}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Command}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Command}"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </Border>
                                <Border Background="{DynamicResource MutedBrush}"
                                        CornerRadius="{DynamicResource WpfPremium.SurfaceCornerRadius}"
                                        Padding="10"
                                        Margin="0,2,0,6">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Output}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Output}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Output}"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="{Binding Details}"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,6">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="FontFamily" Value="Segoe UI" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Details}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Details}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static controls:TraceEntryKind.StackTrace}">
                                                    <Setter Property="FontFamily" Value="Consolas" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static controls:TraceEntryKind.Terminal}">
                                                    <Setter Property="FontFamily" Value="Consolas" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Sources}" Margin="0,2,0,6">
                                    <ItemsControl.Style>
                                        <Style TargetType="{x:Type ItemsControl}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Sources.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type controls:TraceSource}">
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <Button Content="{Binding Title}"
                                                        Command="{Binding OpenCommand}"
                                                        Padding="0"
                                                        MinHeight="0">
                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonLink}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding OpenCommand}" Value="{x:Null}">
                                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <TextBlock Text="{Binding Uri}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           FontSize="11"
                                                           Margin="8,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Children}" Margin="0,2,0,6">
                                    <ItemsControl.Style>
                                        <Style TargetType="{x:Type ItemsControl}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Children.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type controls:TraceEntry}">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <iconPacks:PackIconMaterial Kind="{Binding DisplayIcon}"
                                                                            Width="12"
                                                                            Height="12"
                                                                            Margin="0,0,6,0"
                                                                            VerticalAlignment="Center">
                                                    <iconPacks:PackIconMaterial.Style>
                                                        <Style TargetType="{x:Type iconPacks:PackIconMaterial}">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TraceActiveBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </iconPacks:PackIconMaterial.Style>
                                                </iconPacks:PackIconMaterial>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Title}"
                                                           Foreground="{DynamicResource ForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Status}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           Margin="8,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button Content="{Binding NavigationLabel, TargetNullValue=Mở}"
                                            Command="{Binding NavigationCommand}"
                                            Margin="0,0,12,0">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonLink}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NavigationCommand}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{Binding ActionLabel, TargetNullValue=Mở}"
                                            Command="{Binding ActionCommand}">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonLink}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActionCommand}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            </Grid>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Typography" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource WpfPremium.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource WpfPremium.FontSize}" />
    </Style>
    <Style x:Key="TypographyH1" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Typography}">
        <Setter Property="FontSize" Value="{DynamicResource WpfPremium.Heading1FontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="TypographyH2" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Typography}">
        <Setter Property="FontSize" Value="{DynamicResource WpfPremium.Heading2FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TypographyH3" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Typography}">
        <Setter Property="FontSize" Value="{DynamicResource WpfPremium.Heading3FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TypographyMuted" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Typography}">
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
    </Style>

    <Style x:Key="TreeViewStyle" TargetType="{x:Type TreeView}">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource WpfPremium.SurfaceBorderThickness}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource TreeViewItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeView}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource WpfPremium.SurfaceCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False" CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TreeViewItemStyle" TargetType="{x:Type TreeViewItem}">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Padding" Value="4,5" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ToggleButton x:Name="Expander" Grid.Column="0" Width="18" Height="26"
                                      Focusable="False" IsTabStop="False" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource MutedForegroundBrush}"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <iconPacks:PackIconMaterial Kind="ChevronRight" Width="14" Height="14" />
                        </ToggleButton>
                        <Border x:Name="HeaderBorder" Grid.Column="1" Padding="{TemplateBinding Padding}"
                                CornerRadius="{DynamicResource WpfPremium.ControlCornerRadius}" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter x:Name="HeaderHost" ContentSource="Header" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Margin="12,1,0,0" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True"><Setter TargetName="Expander" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Expander" Property="Content">
                                <Setter.Value>
                                    <iconPacks:PackIconMaterial Kind="ChevronDown" Width="14" Height="14" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource MutedBrush}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource MutedBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HeaderBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="1.008" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="HeaderBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="1.008" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HeaderBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="HeaderBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
