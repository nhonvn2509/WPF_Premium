                            <Setter TargetName="DividerLine" Property="Width" Value="1" />
                            <Setter TargetName="DividerLine" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="DividerLine" Property="VerticalAlignment" Value="Stretch" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Margin" Value="8,0" />
