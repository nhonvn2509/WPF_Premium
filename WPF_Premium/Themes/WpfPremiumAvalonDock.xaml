<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avalonDock="clr-namespace:AvalonDock;assembly=AvalonDock"
                    xmlns:avalonDockControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
                    xmlns:avalonDockThemes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock">
    <avalonDockThemes:GenericTheme x:Key="WpfPremiumDockingTheme" />

    <Style TargetType="{x:Type avalonDock:DockingManager}">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="AnchorableContextMenu">
            <Setter.Value>
                <ContextMenu Background="{DynamicResource CardBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="4"
                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="{DynamicResource AvalonDock.Float}" Command="{Binding DetachToWindowCommand}" />
                    <MenuItem Header="{DynamicResource AvalonDock.Dock}" Command="{Binding DockCommand}" />
                    <MenuItem Header="{DynamicResource AvalonDock.DockAsDocument}" Command="{Binding DockAsDocumentCommand}" />
                    <MenuItem Header="{DynamicResource AvalonDock.AutoHide}" Command="{Binding AutoHideCommand}" />
                    <Separator />
                    <MenuItem Header="{DynamicResource AvalonDock.Hide}" Command="{Binding HideCommand}" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type avalonDockControls:LayoutDocumentPaneControl}">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style TargetType="{x:Type avalonDockControls:LayoutAnchorablePaneControl}">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style TargetType="{x:Type avalonDockControls:LayoutDocumentTabItem}">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu Background="{DynamicResource CardBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="4"
                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="{DynamicResource AvalonDock.Close}" Command="{Binding CloseCommand}" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding LayoutItem.IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type avalonDockControls:LayoutAnchorableTabItem}">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu Background="{DynamicResource CardBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="4"
                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="{DynamicResource AvalonDock.AutoHide}" Command="{Binding AutoHideCommand}" />
                    <MenuItem Header="{DynamicResource AvalonDock.Dock}" Command="{Binding DockCommand}" />
                    <MenuItem Header="{DynamicResource AvalonDock.Float}" Command="{Binding DetachToWindowCommand}" />
                    <Separator />
                    <MenuItem Header="{DynamicResource AvalonDock.Hide}" Command="{Binding HideCommand}" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding LayoutItem.IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type avalonDockControls:AnchorablePaneTitle}">
        <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu Background="{DynamicResource CardBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="4"
                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="{DynamicResource AvalonDock.Float}" Command="{Binding DetachToWindowCommand}" />
                    <MenuItem Header="{DynamicResource AvalonDock.Dock}" Command="{Binding DockCommand}" />
                    <MenuItem Header="{DynamicResource AvalonDock.DockAsDocument}" Command="{Binding DockAsDocumentCommand}" />
                    <MenuItem Header="{DynamicResource AvalonDock.AutoHide}" Command="{Binding AutoHideCommand}" />
                    <Separator />
                    <MenuItem Header="{DynamicResource AvalonDock.Hide}" Command="{Binding HideCommand}" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
