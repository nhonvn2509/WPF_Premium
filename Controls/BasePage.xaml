<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="WPF_Premium.Controls.BasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mahapps="http://metro.mahapps.com/winfx/xaml/controls"
             Height="Auto" Width="Auto">
    <Grid>
        <Border Background="{DynamicResource MaterialDesignBackground}" Padding="16">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="Bold" Margin="0,0,0,12" />
                <ContentControl Content="{Binding PageContent}" />
            <StackPanel>
        </Border>
    </Grid>
</UserControl>