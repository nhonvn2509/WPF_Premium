<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:mahapps="http://metro.mahapps.com/winfx/xaml/controls">
  <!-- Merge Material Design and MahApps themes -->
  <ResourceDictionary.MergedDictionaries>
    <material:BundledTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="Lime" />
    <mahapps:MetroResources />
  </ResourceDictionary.MergedDictionaries>

  <!-- Global font style -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Button style (Material flat) -->
  <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
    <Setter Property="Margin" Value="4" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <!-- Card style for containers -->
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
    <Setter Property="Margin" Value="8" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.2" />
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>