<UserControl x:Class="WPF_Premium_Demo.ExtendedComponentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WPF_Premium.Controls;assembly=WPF_Premium.Core"
             Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="980">
            <TextBlock Text="Thành phần mở rộng" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
            <TextBlock Text="Bộ điều khiển tương tác mới: BannerAlert, Breadcrumb, SegmentedControl, NumericUpDown, TagInput, Skeleton, TimelineControl và Toast xếp chồng."
                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,4,0,20" TextWrapping="Wrap" />

            <!-- Accent Color Customization -->
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Tùy biến màu nhấn (ThemeManager.SetAccentColor)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBlock Text="Thử đổi màu chủ đạo toàn ứng dụng với độ tương phản tự động." FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Mặc định" Style="{StaticResource ButtonOutline}" Margin="0,0,8,0" Click="AccentReset_Click" />
                        <Button Content="Xanh dương" Style="{StaticResource ButtonSecondary}" Margin="0,0,8,0" Tag="#2563EB" Click="AccentPreset_Click" />
                        <Button Content="Xanh lá" Style="{StaticResource ButtonSecondary}" Margin="0,0,8,0" Tag="#16A34A" Click="AccentPreset_Click" />
                        <Button Content="Tím" Style="{StaticResource ButtonSecondary}" Margin="0,0,8,0" Tag="#7C3AED" Click="AccentPreset_Click" />
                        <Button Content="Cam" Style="{StaticResource ButtonSecondary}" Tag="#EA580C" Click="AccentPreset_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- BannerAlert -->
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="BannerAlert (Tất cả biến thể)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" />
                        <Button x:Name="ResetBannersButton" Content="Hiện lại tất cả" Style="{StaticResource ButtonOutline}" DockPanel.Dock="Right" Click="ResetBanners_Click" />
                    </DockPanel>
                    <controls:BannerAlert x:Name="InfoBanner"
                                          Kind="Info"
                                          Title="Cập nhật hệ thống"
                                          Message="Phiên bản WPF_Premium mới bổ sung 7 thành phần UI và tối ưu hiệu năng hiển thị."
                                          ActionText="Xem chi tiết"
                                          ActionClicked="InfoBanner_ActionClicked"
                                          Margin="0,0,0,10" />
                    <controls:BannerAlert x:Name="SuccessBanner"
                                          Kind="Success"
                                          Title="Đồng bộ hoàn tất"
                                          Message="Tất cả cấu hình giao diện đã được áp dụng cho phiên làm việc hiện tại."
                                          Margin="0,0,0,10" />
                    <controls:BannerAlert x:Name="WarningBanner"
                                          Kind="Warning"
                                          Title="Cảnh báo dung lượng"
                                          Message="Bộ nhớ đệm đang sử dụng 82% dung lượng cho phép."
                                          Margin="0,0,0,10" />
                    <controls:BannerAlert x:Name="DestructiveBanner"
                                          Kind="Destructive"
                                          CornerRadius="12"
                                          IconKind="AlertOctagonOutline"
                                          Title="Lỗi kết nối máy chủ"
                                          Message="Không thể kết nối tới điểm cuối đồng bộ. Vui lòng kiểm tra cấu hình mạng." />
                </StackPanel>
            </Border>

            <!-- Breadcrumb & SegmentedControl -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Breadcrumb" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10" />
                        <controls:Breadcrumb x:Name="DemoBreadcrumb" ItemClicked="DemoBreadcrumb_ItemClicked" />
                        <TextBlock x:Name="BreadcrumbStatusText" Text="Nhấn vào mục trước đó để điều hướng."
                                   FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="SegmentedControl" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10" />
                        <controls:SegmentedControl x:Name="DemoSegmented" SelectionChanged="DemoSegmented_SelectionChanged" />
                        <TextBlock x:Name="SegmentedStatusText" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- NumericUpDown & TagInput -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="NumericUpDown (Số nguyên, thập phân, chỉ đọc)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <controls:NumericUpDown x:Name="DemoNumeric" Width="140" Minimum="0" Maximum="100" Step="5" Value="25" ValueChanged="DemoNumeric_ValueChanged" />
                            <TextBlock x:Name="NumericStatusText" Text="Giá trị: 25" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:NumericUpDown Width="140" Minimum="0" Maximum="10" Step="0.25" StringFormat="0.00" Value="2.5" CornerRadius="10" Margin="0,0,10,0" />
                            <controls:NumericUpDown Width="110" Minimum="0" Maximum="100" Value="40" ShowButtons="False" IsReadOnly="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="TagInput (nhấn Enter hoặc dấu phẩy)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,10" />
                        <controls:TagInput x:Name="DemoTagInput" TagsChanged="DemoTagInput_TagsChanged" />
                        <TextBlock x:Name="TagStatusText" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Skeleton & TimelineControl -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Skeleton Loading" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="SkeletonActiveToggle" Content="Hoạt động" Style="{StaticResource Switch}" IsChecked="True" DockPanel.Dock="Right"
                                          Checked="SkeletonToggle_Changed" Unchecked="SkeletonToggle_Changed" />
                        </DockPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:Skeleton x:Name="SkeletonAvatar" Kind="Avatar" Width="44" Height="44" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <controls:Skeleton x:Name="SkeletonLine1" Kind="Text" Height="14" Margin="0,0,0,8" />
                                <controls:Skeleton x:Name="SkeletonLine2" Kind="Text" Width="180" HorizontalAlignment="Left" Height="12" />
                            </StackPanel>
                        </Grid>
                        <controls:Skeleton x:Name="SkeletonCard" Kind="Card" Height="76" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="TimelineControl &amp; Stacked Toast" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" />
                            <Button Content="Thử 3 Toast" Style="{StaticResource ButtonSecondary}" DockPanel.Dock="Right" Click="ShowStackedToasts_Click" />
                        </DockPanel>
                        <controls:TimelineControl x:Name="DemoTimeline" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
