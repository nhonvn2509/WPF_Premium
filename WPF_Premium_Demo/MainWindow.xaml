<premium:PremiumWindow x:Class="WPF_Premium_Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:demo="clr-namespace:WPF_Premium_Demo"
        xmlns:premium="clr-namespace:WPF_Premium.Controls;assembly=WPF_Premium"
        xmlns:themes="clr-namespace:WPF_Premium.Themes;assembly=WPF_Premium"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        AutomationProperties.AutomationId="WpfPremiumDemoWindow"
        Title="WPF Premium"
        Width="1600"
        Height="1000"
        MinWidth="1200"
        MinHeight="800"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource CardBrush}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="W" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="WPF Premium" Margin="10,0,0,0"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Page Title -->
                <TextBlock x:Name="PageTitle" Grid.Column="1"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="13" FontWeight="Medium"
                           Foreground="{DynamicResource MutedForegroundBrush}" />

                <!-- Toolbar Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Giao diện" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11"
                               Margin="0,0,6,0" />
                    <Button Content="Sáng" Tag="Light" Click="SetTheme_Click"
                            Style="{StaticResource ButtonOutline}" Margin="0,0,5,0" />
                    <Button Content="Tối" Tag="Dark" Click="SetTheme_Click"
                            Style="{StaticResource ButtonOutline}" />
                    <premium:AppearanceSettingsControl Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="60" MaxWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightPanelColumn" Width="0" MinWidth="0" MaxWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border x:Name="Sidebar" Grid.Column="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource CardBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel Margin="12,10">
                            <Button x:Name="ToggleSidebarButton" DockPanel.Dock="Right"
                                    Style="{StaticResource ButtonGhost}" Padding="6"
                                    ToolTip="Thu gọn thanh bên" Click="ToggleSidebar_Click">
                                <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="16" Height="16" />
                            </Button>
                            <TextBlock Text="Danh mục" FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Search Box -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="8,8,8,0">
                        <Grid Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="Magnify" Width="16" Height="16"
                                                        Foreground="{DynamicResource MutedForegroundBrush}"
                                                        VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     Tag="Tìm kiếm điều khiển..."
                                     FontSize="12"
                                     Padding="6,4"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged" />
                        </Grid>
                    </Border>

                    <!-- Navigation Tree -->
                    <TreeView x:Name="NavTree" Grid.Row="2" Margin="6,8,6,6"
                              Style="{StaticResource TreeViewStyle}"
                              SelectedItemChanged="NavTree_SelectedItemChanged"
                              AutomationProperties.Name="Điều hướng demo">
                        <TreeViewItem IsExpanded="True" Style="{StaticResource TreeViewItemStyle}">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="PaletteOutline" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Text="Cơ bản" />
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem x:Name="NavAppearance" Tag="Page.Appearance" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ThemeLightDark" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Giao diện" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavButtons" Tag="Page.Buttons" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="GestureTapButton" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Nút" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavForms" Tag="Page.Forms" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FormDropdown" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Biểu mẫu" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavTabs" Tag="Page.Tabs" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="TabUnselected" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Thẻ" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavFilePreview" Tag="Page.FilePreview" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FileEyeOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Xem trước tệp" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavDialogs" Tag="Page.Dialogs" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="MessageTextOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Hộp thoại" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                        </TreeViewItem>

                        <Separator Style="{StaticResource Marker}" Margin="6,4" />

                        <TreeViewItem IsExpanded="True" Style="{StaticResource TreeViewItemStyle}">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ViewGridOutline" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Text="Thư viện điều khiển" />
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem x:Name="NavTreeView" Tag="Page.TreeView" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="TreeOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Cây điều hướng" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavToolbar" Tag="Page.Toolbar" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Wrench" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Thanh công cụ" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavAccordion" Tag="Page.Accordion" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="CollapseAllOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Ngăn xếp / Thu gọn" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavAlert" Tag="Page.Alert" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="AlertOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Cảnh báo / Trống / Mục" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavFormControls" Tag="Page.FormControls" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FormTextbox" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Tệp / Trường / Ô nhập" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavCalendar" Tag="Page.Calendar" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="CalendarMonthOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Lịch / Ngày giờ" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavSelectors" Tag="Page.Selectors" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="CheckboxMultipleOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Hộp chọn / Lệnh" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavMenus" Tag="Page.Menus" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Menu" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Trình đơn" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavButtonsGallery" Tag="Page.ButtonsGallery" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="GestureTapButton" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Nút / Công tắc" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavPagination" Tag="Page.Pagination" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="PageNextOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Phân trang / Tiến trình" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavTable" Tag="Page.Table" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Table" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Bảng / Chú giải" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavBadge" Tag="Page.Badge" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="TagOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Badge" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavDivider" Tag="Page.Divider" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="MinusBoxOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Divider" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavStepBar" Tag="Page.StepBar" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ProgressCheck" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="StepBar" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavWaterfall" Tag="Page.Waterfall" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ViewColumnOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Waterfall Panel" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavCharts" Tag="Page.Charts" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="ChartLine" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Biểu đồ" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavTrace" Tag="Page.Trace" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="TimelineOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Trace / Kiểu chữ" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavOverlays" Tag="Page.Overlays" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="WindowOpen" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Hộp thoại / Bảng trượt" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavDocking" Tag="Page.Docking" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="WindowRestore" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="AvalonDock" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                            <TreeViewItem x:Name="NavOfflineMap" Tag="Page.OfflineMap" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="MapOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="Bản đồ ngoại tuyến" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                        </TreeViewItem>
                    </TreeView>

                    <!-- Sidebar Footer -->
                    <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="6,0,6,6">
                        <StackPanel Orientation="Horizontal" Margin="8">
                            <TextBlock Text="Phiên bản 1.0.0" FontSize="10"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Sidebar Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <!-- Central Content Area -->
            <Border Grid.Column="2" Background="{DynamicResource BackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Page Header -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource CardBrush}">
                        <DockPanel Margin="16,10">
                            <TextBlock x:Name="ContentHeaderTitle" Text="Giao diện"
                                       FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ShowCodeButton" Content="Xem mã"
                                        Style="{StaticResource ButtonOutline}" Padding="12,6"
                                        Click="ShowCodeButton_Click" />
                                <Button x:Name="OpenRightPanelButton" Style="{StaticResource ButtonGhost}" Padding="8"
                                        ToolTip="Mở bảng thông tin" Click="OpenRightPanel_Click">
                                    <iconPacks:PackIconMaterial Kind="InformationOutline" Width="16" Height="16" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Page Content -->
                    <ContentControl x:Name="PageContent" Grid.Row="1" />
                </Grid>
            </Border>

            <!-- Right Panel Splitter -->
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Visibility="{Binding ElementName=RightPanelColumn, Path=Width, Converter={StaticResource WpfPremiumBooleanToVisibilityConverter}}" />

            <!-- Right Panel (Code Example/Inspector) -->
            <Border x:Name="RightPanel" Grid.Column="4"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Background="{DynamicResource CardBrush}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel Margin="12,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ButtonGhost}" Padding="6"
                                    ToolTip="Đóng bảng" Click="CloseRightPanel_Click">
                                <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" />
                            </Button>
                            <TextBlock Text="Mã ví dụ" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12">
                        <StackPanel x:Name="RightPanelContent" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</premium:PremiumWindow>