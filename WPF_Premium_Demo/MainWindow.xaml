<Window x:Class="WPF_Premium_Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:demo="clr-namespace:WPF_Premium_Demo"
        xmlns:premium="clr-namespace:WPF_Premium.Controls;assembly=WPF_Premium"
        xmlns:themes="clr-namespace:WPF_Premium.Themes;assembly=WPF_Premium"
        AutomationProperties.AutomationId="WpfPremiumDemoWindow"
        Title="WPF Premium"
        Width="1120"
        Height="860"
        MinWidth="820"
        MinHeight="680"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="W" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="WPF Premium" Margin="10,0,0,0"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Giao diện" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12"
                               Margin="0,0,8,0" />
                    <Button Content="Sáng" Tag="Light" Click="SetTheme_Click"
                            Style="{StaticResource ButtonOutline}" Margin="0,0,6,0" />
                    <Button Content="Tối" Tag="Dark" Click="SetTheme_Click"
                            Style="{StaticResource ButtonOutline}" />
                    <premium:AppearanceSettingsControl Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="56,40,40,48">
                <TextBlock Text="Bộ thành phần giao diện" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Nền tảng gọn gàng, linh hoạt để xây dựng ứng dụng WPF hiện đại."
                           FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="0,8,0,30" />

                <TextBlock Text="Nút" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <WrapPanel Margin="0,0,0,30">
                    <Button Content="Chính" Margin="0,0,8,8" />
                    <Button Content="Phụ" Style="{StaticResource ButtonSecondary}" Margin="0,0,8,8" />
                    <Button Content="Viền" Style="{StaticResource ButtonOutline}" Margin="0,0,8,8" />
                    <Button Content="Trong suốt" Style="{StaticResource ButtonGhost}" Margin="0,0,8,8" />
                    <Button Content="Nguy hiểm" Style="{StaticResource ButtonDestructive}" Margin="0,0,8,8" />
                    <Button Content="Đã tắt" IsEnabled="False" Margin="0,0,8,8" />
                </WrapPanel>

                <TextBlock Text="Điều khiển biểu mẫu" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,0,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Thư điện tử" FontSize="13" FontWeight="Medium" Margin="0,0,0,8" />
                            <TextBox Text="name@example.com" />
                            <TextBlock Text="Chúng tôi sẽ không chia sẻ địa chỉ thư điện tử của bạn."
                                       FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,7,0,18" />
                            <CheckBox Content="Tôi đồng ý với các điều khoản" IsChecked="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tùy chọn" FontSize="13" FontWeight="Medium" Margin="0,0,0,14" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="True" />
                                <TextBlock Text="Bật thông báo" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Style="{StaticResource Switch}" />
                                <TextBlock Text="Tin tức tiếp thị" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Thẻ" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TabControl Margin="0,0,0,30">
                    <TabItem Header="Tổng quan">
                        <StackPanel>
                            <TextBlock Text="Tổng quan" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Bảng thẻ đơn giản sử dụng TabControl tích hợp của WPF."
                                       Margin="0,6,0,0" Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Cài đặt">
                        <StackPanel>
                            <TextBlock Text="Cài đặt" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Đặt các điều khiển cấu hình và mô tả tại đây."
                                       Margin="0,6,0,0" Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Đã tắt" IsEnabled="False" />
                </TabControl>

                <TextBlock Text="Xem trước tệp" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,30">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Xem trước hình ảnh, âm thanh, video, văn bản, thư điện tử và Office" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" />
                            <Button Content="Chọn tệp" Click="ChoosePreviewFile_Click" Style="{StaticResource ButtonOutline}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <premium:FilePreviewControl x:Name="FilePreview" MinHeight="440" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Hộp thoại" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="22">
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="Hộp thoại phương thức" FontWeight="Medium" FontSize="14" />
                            <TextBlock Text="Mở hộp thoại theo giao diện thống nhất mà không cần thêm thư viện giao diện."
                                       Margin="0,6,0,0" Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>
                        <Button Content="Mở hộp thoại" Click="OpenDialog_Click"
                                Style="{StaticResource ButtonOutline}" DockPanel.Dock="Right"
                                Margin="20,0,0,0" />
                    </DockPanel>
                </Border>
                <demo:ControlsGallery />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
