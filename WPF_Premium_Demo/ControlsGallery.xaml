                        <TextBlock Text="Tổng quan" VerticalAlignment="Center" />
                        <controls:Divider Orientation="Vertical" />
                        <TextBlock Text="Chi tiết" VerticalAlignment="Center" />
                        <controls:Divider Orientation="Vertical" />
                        <TextBlock Text="Lịch sử" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="StepBarSection" Width="880" Padding="18" Margin="0,0,16,16" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
