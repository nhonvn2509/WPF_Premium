                        <Border Background="{DynamicResource MutedBrush}" CornerRadius="6" Padding="12">
                            <TextBlock Text="Thẻ ngắn. Các mục được dồn vào cột đang thấp nhất."
                                       TextWrapping="Wrap" />
                        </Border>
                        <Border Background="{DynamicResource MutedBrush}" CornerRadius="6" Padding="12">
                            <TextBlock Text="Thẻ cao hơn với nội dung dài hơn để minh họa cách bố cục tự cân bằng theo chiều cao của từng cột."
                                       TextWrapping="Wrap" />
                        </Border>
                        <Border Background="{DynamicResource MutedBrush}" CornerRadius="6" Padding="12">
                            <TextBlock Text="Thẻ vừa, hiển thị thêm một dòng mô tả."
                                       TextWrapping="Wrap" />
                        </Border>
                        <Border Background="{DynamicResource MutedBrush}" CornerRadius="6" Padding="12">
                            <TextBlock Text="Mục tiếp theo sẽ được đặt bên dưới cột hiện đang có tổng chiều cao nhỏ nhất."
                                       TextWrapping="Wrap" />
                        </Border>
                        <Border Background="{DynamicResource MutedBrush}" CornerRadius="6" Padding="12">
                            <TextBlock Text="Một thẻ ngắn nữa." TextWrapping="Wrap" />
                        </Border>
                        <Border Background="{DynamicResource MutedBrush}" CornerRadius="6" Padding="12">
