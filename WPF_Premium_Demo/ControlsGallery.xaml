                        <controls:ChartControl x:Name="LineChart" Kind="Line"
                                               Title="Doanh thu theo tháng"
                                               Description="Biểu đồ đường gồm nhiều chuỗi dữ liệu."
                                               Width="400" Height="290" Margin="0,0,12,12" />
                        <controls:ChartControl x:Name="AreaChart" Kind="Area"
                                               Title="Người dùng hoạt động"
                                               Description="Biểu đồ miền."
                                               Width="400" Height="290" Margin="0,0,12,12" />
                        <controls:ChartControl x:Name="ColumnChart" Kind="Column"
                                               Title="Đơn hàng theo tháng"
                                               Description="Biểu đồ cột nhóm."
                                               Width="400" Height="290" Margin="0,0,12,12" />
                        <controls:ChartControl x:Name="BarChart" Kind="Bar"
                                               Title="Công việc theo nhóm"
                                               Description="Biểu đồ thanh ngang."
                                               Width="400" Height="290" Margin="0,0,12,12" />
                        <controls:ChartControl x:Name="ScatterChart" Kind="Scatter"
                                               Title="Mẫu thời gian phản hồi"
                                               Description="Biểu đồ phân tán."
                                               Width="400" Height="290" Margin="0,0,12,12" />
                        <controls:ChartControl x:Name="DoughnutChart" Kind="Doughnut"
                                               Title="Nguồn truy cập"
                                               Description="Biểu đồ vành khuyên."
                                               Width="400" Height="290" Margin="0,0,12,12" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="TraceSection" Width="430" Padding="12" Margin="0,0,12,12" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Dòng sự kiện / Kiểu chữ / Phím tắt / Nhãn" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ItemsControl Style="{StaticResource Trace}">
                        <controls:TraceEntry Kind="Thought"
                                             Title="Khám phá tài liệu và ví dụ"
                                             Duration="2s"
                                             Description="Đã đọc 2 tệp, tìm 1 cụm từ và thực hiện 2 bước khác"
                                             IsExpanded="True">
                            <controls:TraceEntry.Children>
                                <controls:TraceEntry Kind="Sources" Title="Đọc TraceEntry.cs" />
                                <controls:TraceEntry Kind="Tool" Title="Tìm mẫu giao diện Trace" />
                                <controls:TraceEntry Kind="Sources" Title="Đọc README.md" />
                                <controls:TraceEntry Kind="Sources" Title="Đọc ControlsGallery.xaml, dòng 190 đến 250" />
                                <controls:TraceEntry Kind="Sources" Title="Đọc WpfPremium.xaml, dòng 820 đến 950" />
                            </controls:TraceEntry.Children>
                        </controls:TraceEntry>
                        <controls:TraceEntry Kind="Reasoning"
                                             Title="Đã xem thiết kế API cho thành phần và liên kết"
                                             Duration="42s" />
                        <controls:TraceEntry Kind="Task"
                                             Title="Đã sửa 2 tệp"
                                             AddedLines="489"
                                             RemovedLines="102" />
                        <controls:TraceEntry Kind="Thought"
                                             Title="Đang suy nghĩ"
                                             Status="Đang thực hiện"
                                             IsActive="True"
                                             IsExpanded="True"
                                             Description="Đang chuẩn bị bước tiếp theo." />
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                        <Label Content="Phím tắt:" Style="{StaticResource Label}" />
                        <ContentControl Content="Ctrl + K" Style="{StaticResource Kbd}" />
                    </StackPanel>
                    <TextBlock Text="Tiêu đề kiểu chữ" Style="{StaticResource TypographyH2}" />
                    <TextBlock Text="Văn bản mô tả phụ" Style="{StaticResource TypographyMuted}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="OverlaysSection" Width="880" Padding="12" Margin="0,0,12,12" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Hộp thoại / Hộp cảnh báo / Ngăn trượt / Bảng trượt / Thông báo" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <UniformGrid Columns="3">
                        <Border Background="{DynamicResource MutedBrush}" CornerRadius="6" Padding="12" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Hộp thoại" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="Tác vụ cần xác nhận rõ ràng."
                                           Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <Button Content="Hộp thoại" Tag="Dialog" Click="OpenPanel_Click"
                                        Style="{StaticResource ButtonOutline}" HorizontalAlignment="Left" Margin="0,0,0,6" />
                                <Button Content="Hộp cảnh báo" Tag="AlertDialog" Click="OpenPanel_Click"
                                        Style="{StaticResource ButtonOutline}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource MutedBrush}" CornerRadius="6" Padding="12" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Ngăn trượt" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="Chọn hướng mở để phù hợp bố cục."
                                           Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Content="Trái" Tag="Drawer:Left" Click="OpenPanel_Click" Style="{StaticResource ButtonOutline}" Margin="0,0,6,6" />
                                    <Button Content="Trên" Tag="Drawer:Top" Click="OpenPanel_Click" Style="{StaticResource ButtonOutline}" Margin="0,0,6,6" />
                                    <Button Content="Phải" Tag="Drawer:Right" Click="OpenPanel_Click" Style="{StaticResource ButtonOutline}" Margin="0,0,6,6" />
                                    <Button Content="Dưới" Tag="Drawer:Bottom" Click="OpenPanel_Click" Style="{StaticResource ButtonOutline}" Margin="0,0,6,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource MutedBrush}" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Bảng trượt &amp; thông báo" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="Hiển thị nội dung phụ hoặc thông tin phản hồi nhanh."
                                           Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Content="Trái" Tag="Sheet:Left" Click="OpenPanel_Click" Style="{StaticResource ButtonOutline}" Margin="0,0,6,6" />
                                    <Button Content="Trên" Tag="Sheet:Top" Click="OpenPanel_Click" Style="{StaticResource ButtonOutline}" Margin="0,0,6,6" />
                                    <Button Content="Phải" Tag="Sheet:Right" Click="OpenPanel_Click" Style="{StaticResource ButtonOutline}" Margin="0,0,6,6" />
                                    <Button Content="Dưới" Tag="Sheet:Bottom" Click="OpenPanel_Click" Style="{StaticResource ButtonOutline}" Margin="0,0,6,6" />
                                    <Button Content="Thông báo" Click="ShowToast_Click" Style="{StaticResource ButtonOutline}" Margin="0,0,6,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border x:Name="DockingSection" Width="880" Padding="12" Margin="0,0,12,12" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource AvalonDock.Title}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Tiếng Việt" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>
                    </DockPanel>
                    <avalonDock:DockingManager x:Name="DockingPreview"
                                               Height="480"
                                               Style="{StaticResource WpfPremiumDockingManager}">
                        <avalonDockLayout:LayoutRoot>
                            <avalonDockLayout:LayoutPanel Orientation="Horizontal">
                                <avalonDockLayout:LayoutAnchorablePane DockWidth="220">
                                    <avalonDockLayout:LayoutAnchorable Title="{DynamicResource AvalonDock.SolutionExplorer}"
                                                                       ContentId="SolutionExplorer">
                                        <TextBlock Text="WPF_Premium"
                                                   Margin="12"
                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                    </avalonDockLayout:LayoutAnchorable>
                                    <avalonDockLayout:LayoutAnchorable Title="{DynamicResource AvalonDock.Output}"
                                                                       ContentId="Output">
                                        <TextBlock Text="Tạo bản dựng thành công."
                                                   Margin="12"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                                    </avalonDockLayout:LayoutAnchorable>
                                </avalonDockLayout:LayoutAnchorablePane>
                                <avalonDockLayout:LayoutDocumentPane>
                                    <avalonDockLayout:LayoutDocument Title="{DynamicResource AvalonDock.Document}"
                                                                     ContentId="Document">
                                        <TextBlock Text="{DynamicResource AvalonDock.Welcome}"
                                                   Margin="18"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" />
                                    </avalonDockLayout:LayoutDocument>
                                </avalonDockLayout:LayoutDocumentPane>
                            </avalonDockLayout:LayoutPanel>
                        </avalonDockLayout:LayoutRoot>
                    </avalonDock:DockingManager>
                </StackPanel>
            </Border>
        </WrapPanel>
        <Border x:Name="OfflineMapSection" Padding="10" Margin="0,0,0,16" CornerRadius="6"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Bản đồ ngoại tuyến" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="Phóng to để xem thêm đường bờ và tên đảo, rạn, bãi cạn. Dữ liệu chỉ mang tính tham khảo, không dùng để điều hướng; ứng dụng chỉ cần truyền tọa độ WGS84 để đánh dấu vị trí."
                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,8" />
                <controls:OfflineMapControl x:Name="OfflineMapPreview" Height="480" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
