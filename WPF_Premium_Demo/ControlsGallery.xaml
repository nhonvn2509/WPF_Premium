                            <avalonDockLayout:LayoutPanel Orientation="Horizontal">
                                <avalonDockLayout:LayoutAnchorablePane DockWidth="220">
                                    <avalonDockLayout:LayoutAnchorable Title="{DynamicResource AvalonDock.SolutionExplorer}"
