<UserControl x:Class="WPF_Premium_Demo.ControlsGallery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WPF_Premium.Controls;assembly=WPF_Premium"
             xmlns:avalonDock="clr-namespace:AvalonDock;assembly=AvalonDock"
             xmlns:avalonDockLayout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <StackPanel x:Name="GalleryRoot" Margin="20,16,20,20">
        <Border x:Name="TreeViewSection" Padding="10" Margin="0,0,0,16" CornerRadius="6"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Cây điều hướng" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TreeView Style="{StaticResource TreeViewStyle}" MinHeight="300" MaxHeight="360">
                    <TreeViewItem IsExpanded="True" Style="{StaticResource TreeViewItemStyle}">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}" />
                                <TextBlock Text="Không gian làm việc" />
                            </StackPanel>
                        </TreeViewItem.Header>
                        <TreeViewItem IsExpanded="True" Style="{StaticResource TreeViewItemStyle}">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FolderOutline" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Text="src" />
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FolderOutline" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="Điều khiển" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                                <TreeViewItem Style="{StaticResource TreeViewItemStyle}">
                                    <TreeViewItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Xml" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource MutedForegroundBrush}" />
                                            <TextBlock Text="TreeView.xaml" />
                                        </StackPanel>
                                    </TreeViewItem.Header>
                                </TreeViewItem>
                                <TreeViewItem Style="{StaticResource TreeViewItemStyle}">
                                    <TreeViewItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="LanguageCsharp" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource MutedForegroundBrush}" />
                                            <TextBlock Text="TreeView.xaml.cs" />
                                        </StackPanel>
                                    </TreeViewItem.Header>
                                </TreeViewItem>
                            </TreeViewItem>
                            <TreeViewItem Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FolderOutline" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="Giao diện" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                        </TreeViewItem>
                        <TreeViewItem Style="{StaticResource TreeViewItemStyle}">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FileDocumentOutline" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource MutedForegroundBrush}" />
                                    <TextBlock Text="README.md" />
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>
                        <TreeViewItem Header="tests" IsExpanded="True" Style="{StaticResource TreeViewItemStyle}">
                            <TreeViewItem Header="WPF_Premium.Tests" IsExpanded="True" Style="{StaticResource TreeViewItemStyle}">
                                <TreeViewItem Header="ButtonTests.cs" Style="{StaticResource TreeViewItemStyle}" />
                                <TreeViewItem Header="ThemeTests.cs" Style="{StaticResource TreeViewItemStyle}" />
                                <TreeViewItem Header="GalleryTests.cs" Style="{StaticResource TreeViewItemStyle}" />
                            </TreeViewItem>
                        </TreeViewItem>
                        <TreeViewItem Header="WPF_Premium.sln" Style="{StaticResource TreeViewItemStyle}" />
                        <TreeViewItem Header="Directory.Build.props" Style="{StaticResource TreeViewItemStyle}" />
                    </TreeViewItem>
                </TreeView>
            </StackPanel>
        </Border>

        <Border x:Name="ToolbarSection" Padding="10" Margin="0,0,0,16" CornerRadius="6"
                AutomationProperties.AutomationId="ToolbarDemoSection"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Thanh công cụ kiểu dải băng" FontWeight="SemiBold" Margin="0,0,0,10" />
                <controls:Toolbar Style="{StaticResource Toolbar}" Margin="0,0,0,6"
                                  MinHeight="56"
                                  AutomationProperties.Name="Thanh công cụ chỉnh sửa tài liệu">
                    <StackPanel Style="{StaticResource ToolbarGroup}">
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Sao chép định dạng">
                            <StackPanel Width="48" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="FormatPaint"
                                                            HorizontalAlignment="Center" />
                                <TextBlock Text="Sao chép định dạng" TextAlignment="Center"
                                           TextWrapping="Wrap" FontSize="10" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Dán">
                            <StackPanel Width="48" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="ContentPaste"
                                                            HorizontalAlignment="Center" />
                                <TextBlock Text="Dán" TextAlignment="Center" FontSize="10" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Separator Style="{StaticResource ToolbarSeparator}" />
                    <StackPanel Style="{StaticResource ToolbarGroup}">
                        <controls:ComboBoxControl x:Name="ToolbarFontPicker"
                                                  Width="140" MinWidth="0" Height="28"
                                                  SearchEnabled="False" Placeholder="Phông chữ"
                                                  Style="{StaticResource Combobox}" />
                        <controls:ComboBoxControl x:Name="ToolbarFontSizePicker"
                                                  Width="50" MinWidth="0" Height="28"
                                                  SearchEnabled="False" Placeholder="Cỡ chữ"
                                                  Style="{StaticResource Combobox}" Margin="4,0" />
                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Tăng cỡ chữ">
                            <iconPacks:PackIconMaterial Kind="FormatSize" />
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Xóa định dạng">
                            <iconPacks:PackIconMaterial Kind="FormatClear" />
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="In đậm">
                            <iconPacks:PackIconMaterial Kind="FormatBold" />
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="In nghiêng">
                            <iconPacks:PackIconMaterial Kind="FormatItalic" />
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Gạch chân">
                            <iconPacks:PackIconMaterial Kind="FormatUnderline" />
                        </Button>
                    </StackPanel>
                </controls:Toolbar>
                <controls:Toolbar Style="{StaticResource Toolbar}" Margin="0,0,0,6" MinHeight="56"
                                  AutomationProperties.Name="Căn chỉnh và kiểu chữ">
                    <StackPanel Style="{StaticResource ToolbarGroup}">
                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Danh sách dấu đầu dòng">
                            <iconPacks:PackIconMaterial Kind="FormatListBulleted" />
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Danh sách đánh số">
                            <iconPacks:PackIconMaterial Kind="FormatListNumbered" />
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Căn trái">
                            <iconPacks:PackIconMaterial Kind="FormatAlignLeft" />
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Căn giữa">
                            <iconPacks:PackIconMaterial Kind="FormatAlignCenter" />
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Căn phải">
                            <iconPacks:PackIconMaterial Kind="FormatAlignRight" />
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Căn đều">
                            <iconPacks:PackIconMaterial Kind="FormatAlignJustify" />
                        </Button>
                    </StackPanel>
                </controls:Toolbar>
                <controls:Toolbar Style="{StaticResource Toolbar}" MinHeight="56"
                                  AutomationProperties.Name="Kiểu chữ và thao tác khác">
                    <StackPanel Style="{StaticResource ToolbarGroup}">
                        <Button Style="{StaticResource ToolbarStyleButton}" BorderBrush="{DynamicResource TraceActiveBrush}">
                            <TextBlock Text="Bình thường" FontSize="14" FontWeight="SemiBold" />
                        </Button>
                        <Button Style="{StaticResource ToolbarStyleButton}">
                            <TextBlock Text="Tiêu đề 1" FontSize="14" FontWeight="Bold" />
                        </Button>
                        <Button Style="{StaticResource ToolbarStyleButton}">
                            <TextBlock Text="Tiêu đề 2" FontSize="13" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                    <Separator Style="{StaticResource ToolbarSeparator}" />
                    <StackPanel Style="{StaticResource ToolbarGroup}">
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Tìm và thay thế">
                            <StackPanel Width="54" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Magnify" HorizontalAlignment="Center" />
                                <TextBlock Text="Tìm" TextAlignment="Center" FontSize="10" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Chính tả và ngữ pháp">
                            <StackPanel Width="58" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Spellcheck" HorizontalAlignment="Center" />
                                <TextBlock Text="Chính tả" TextAlignment="Center" FontSize="10" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" ToolTip="Dịch">
                            <StackPanel Width="54" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Translate" HorizontalAlignment="Center" />
                                <TextBlock Text="Dịch" TextAlignment="Center" FontSize="10" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Separator Style="{StaticResource ToolbarSeparator}" />
                    <controls:SplitButton Content="Sắp xếp"
                                          Style="{StaticResource SplitButton}"
                                          ButtonStyle="{StaticResource ButtonOutline}"
                                          VerticalAlignment="Center">
                        <controls:SplitButton.ContextMenu>
                            <ContextMenu Style="{StaticResource DropdownMenu}">
                                <MenuItem Header="Đưa lên trước" />
                                <MenuItem Header="Đưa xuống sau" />
                            </ContextMenu>
                        </controls:SplitButton.ContextMenu>
                    </controls:SplitButton>
                </controls:Toolbar>
                <Border Background="{DynamicResource MutedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,12,0,0" MinHeight="180">
                    <StackPanel>
                        <TextBlock Text="Bản xem trước tài liệu" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Báo cáo dự án · Cập nhật lần cuối hôm nay"
                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,4,0,12" />
                        <TextBlock Text="WPF Premium giúp xây dựng giao diện nhất quán với các điều khiển có thể tùy biến. Thanh công cụ phía trên minh họa cách nhóm thao tác định dạng, căn chỉnh và quản lý nội dung trong một quy trình làm việc."
                                   TextWrapping="Wrap" FontSize="14" LineHeight="24" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <WrapPanel>
            <Border x:Name="AccordionSection" Width="430" Padding="12" Margin="0,0,12,12" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Ngăn xếp / Có thể thu gọn" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Expander Header="WPF Premium là gì?" Style="{StaticResource Accordion}" IsExpanded="True">
                        <TextBlock Text="Các điều khiển linh hoạt được tạo kiểu bằng mẫu WPF tích hợp."
                                   TextWrapping="Wrap" Margin="12,4,12,12" />
                    </Expander>
                    <Expander Header="Tùy chỉnh giao diện" Style="{StaticResource Accordion}" IsExpanded="True">
                        <TextBlock Text="Kết hợp style và resource để đồng bộ màu sắc, khoảng cách và trạng thái tương tác trên toàn ứng dụng."
                                   TextWrapping="Wrap" Margin="12,4,12,12" />
                    </Expander>
                    <Expander Header="Thông tin nâng cao" Style="{StaticResource Collapsible}">
                        <TextBlock Text="Expander hỗ trợ giao diện ngăn xếp và nội dung có thể thu gọn."
                                   TextWrapping="Wrap" Margin="12,4,12,12" />
                    </Expander>
                    <Expander Header="Liên kết tài liệu" Style="{StaticResource Accordion}">
                        <TextBlock Text="Đặt nội dung hướng dẫn, cấu hình hoặc phần trợ giúp vào bên trong mỗi mục."
                                   TextWrapping="Wrap" Margin="12,4,12,12" />
                    </Expander>
                    <Border Background="{DynamicResource MutedBrush}" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Mẹo triển khai" FontWeight="SemiBold" />
                            <TextBlock Text="Giữ tiêu đề ngắn, nhóm nội dung liên quan và chỉ mở sẵn mục quan trọng nhất."
                                       TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="AlertSection" Width="430" Padding="12" Margin="0,0,12,12" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Cảnh báo / Trống / Mục" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ContentControl Style="{StaticResource Alert}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Lưu ý!" FontWeight="SemiBold" />
                            <TextBlock Text="Phiên làm việc của bạn đang hoạt động." Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}" />
                        </StackPanel>
                    </ContentControl>
                    <ContentControl Style="{StaticResource AlertDestructive}" Content="Không thể lưu các thay đổi của bạn." />
                    <ContentControl Style="{StaticResource Alert}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Đã lưu thành công" FontWeight="SemiBold" />
                            <TextBlock Text="Các thay đổi đã được đồng bộ với dự án."
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </ContentControl>
                    <ContentControl Style="{StaticResource Empty}" Margin="0,8">
                        <StackPanel>
                            <TextBlock Text="Không có kết quả" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Hãy thử từ khóa tìm kiếm khác." Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ContentControl>
                    <ContentControl Style="{StaticResource Item}" Content="Mục danh sách có thể tái sử dụng" />
                    <StackPanel Margin="0,8,0,0">
                        <ContentControl Style="{StaticResource Item}" Content="Tác vụ đã hoàn thành · 09:42" />
                        <ContentControl Style="{StaticResource Item}" Content="Đang chờ phê duyệt · 10:15" />
                        <ContentControl Style="{StaticResource Item}" Content="Cập nhật cấu hình · Hôm qua" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="FormSection" Width="430" Padding="12" Margin="0,0,12,12" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Tệp đính kèm / Xác thực biểu mẫu / Ô nhập / Vùng văn bản" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <controls:AttachmentControl Style="{StaticResource Attachment}" />
                    <controls:Field x:Name="ProjectNameField" Label="Tên dự án"
                                    IsRequired="True" Style="{StaticResource Field}">
                        <TextBox x:Name="ProjectNameInput" />
                    </controls:Field>
                    <controls:Field x:Name="RetryCountField" Label="Số lần thử lại"
                                    IsRequired="True" Style="{StaticResource Field}">
                        <TextBox x:Name="RetryCountInput" />
                    </controls:Field>
                    <controls:Field x:Name="EmailField" Label="Thư điện tử"
                                    IsRequired="True" Style="{StaticResource Field}">
                        <TextBox x:Name="EmailInput" Tag="ten@vidu.vn" />
                    </controls:Field>
                    <controls:Field x:Name="TermsField" Label="Điều khoản"
                                    IsRequired="True" Style="{StaticResource Field}">
                        <CheckBox x:Name="TermsInput" Content="Tôi đồng ý với điều khoản" />
                    </controls:Field>
                    <controls:Field x:Name="DeploymentField" Label="Chế độ triển khai"
                                    IsRequired="True" Style="{StaticResource Field}">
                        <StackPanel>
                            <RadioButton x:Name="StandardDeploymentInput" Content="Tiêu chuẩn"
                                         GroupName="ValidationDeployment" />
                            <RadioButton x:Name="CompactDeploymentInput" Content="Thu gọn"
                                         GroupName="ValidationDeployment" />
                        </StackPanel>
                    </controls:Field>
                    <Button Content="Kiểm tra biểu mẫu" Click="ValidateForm_Click"
                            Style="{StaticResource ButtonOutline}" HorizontalAlignment="Left"
                            Margin="0,0,0,12" />
                    <controls:Field x:Name="DescriptionField" Label="Vùng văn bản"
                                    IsRequired="True" Style="{StaticResource Field}">
                        <TextBox x:Name="DescriptionInput" Style="{StaticResource Textarea}" Tag="Mô tả dự án" />
                    </controls:Field>
                    <controls:Field x:Name="KeywordField" Label="Nhóm ô nhập"
                                    IsRequired="True" Style="{StaticResource Field}">
                        <DockPanel Style="{StaticResource InputGroup}">
                            <Button Content="Tìm kiếm" Style="{StaticResource ButtonSecondary}" DockPanel.Dock="Right" />
                            <TextBox x:Name="KeywordInput" Tag="Tìm thành phần..." />
                        </DockPanel>
                    </controls:Field>
                    <controls:Field x:Name="TechnologyField" Label="Chọn nhiều công nghệ"
                                    IsRequired="True" Style="{StaticResource Field}">
                        <controls:MultiSelectControl x:Name="TechnologyMultiSelect"
                                                     Placeholder="Chọn công nghệ"
                                                     Style="{StaticResource MultiSelect}" />
                    </controls:Field>
                    <WrapPanel>
                        <StackPanel Width="220" Margin="0,0,12,0">
                            <controls:Field x:Name="PhoneField" Label="Số điện thoại"
                                            IsRequired="True" Style="{StaticResource Field}">
                                <controls:FormattedInputControl x:Name="PhoneInput" Mask="+## (###) ###-####" Placeholder="+84 (___) ___-____" />
                            </controls:Field>
                        </StackPanel>
                        <StackPanel Width="180">
                            <controls:Field x:Name="BirthDateField" Label="Ngày"
                                            IsRequired="True" Style="{StaticResource Field}">
                                <controls:FormattedInputControl x:Name="BirthDateInput" Mask="##/##/####" Placeholder="ngày/tháng/năm" />
                            </controls:Field>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="CalendarSection" Width="880" Padding="12" Margin="0,0,12,12" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Lịch / Ngày giờ / Khoảng ngày giờ"
                               FontWeight="SemiBold" Margin="0,0,0,12" />
                    <WrapPanel>
                        <controls:CalendarControl Width="300" Style="{StaticResource Calendar}" />
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="Ngày và giờ" FontWeight="Medium" Margin="0,0,0,6" />
                            <controls:DateTimeCalendar x:Name="SingleDateTimePicker"
                                                       Style="{StaticResource DateTimeCalendar}" />
                        </StackPanel>
                    </WrapPanel>
                    <Separator Style="{StaticResource Marker}" />
                    <TextBlock Text="Khoảng ngày và giờ" FontWeight="Medium" Margin="0,0,0,8" />
                    <controls:DateTimeRangeCalendar x:Name="DateTimeRangePicker"
                                                    Style="{StaticResource DateTimeRangeCalendar}" />
                    <Border Background="{DynamicResource MutedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Lịch làm việc hôm nay" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="09:00  ·  Họp nhóm thiết kế" Margin="0,12,0,0" />
                            <TextBlock Text="13:30  ·  Rà soát bản phát hành" Margin="0,8,0,0" />
                            <TextBlock Text="16:00  ·  Cập nhật tiến độ dự án" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="SelectorsSection" Width="430" Padding="12" Margin="0,0,12,12" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Hộp chọn / Lệnh / Nhóm nút chọn" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <controls:Field x:Name="FrameworkField" Label="Nền tảng"
                                    IsRequired="True" Style="{StaticResource Field}">
                        <controls:ComboBoxControl x:Name="FrameworkPicker" Placeholder="Chọn nền tảng"
                                                  Style="{StaticResource Combobox}" />
                    </controls:Field>
                    <ListBox Style="{StaticResource Command}" MaxHeight="100" Margin="0,0,0,12">
                        <ListBoxItem Content="Tìm dự án" />
                        <ListBoxItem Content="Mở cài đặt" />
                        <ListBoxItem Content="Xem tài liệu" />
                    </ListBox>
                    <StackPanel Style="{StaticResource RadioGroup}">
                        <RadioButton Content="Mặc định" GroupName="Plan" IsChecked="True" />
                        <RadioButton Content="Thu gọn" GroupName="Plan" />
                    </StackPanel>
                    <Separator Style="{StaticResource Marker}" Margin="0,12,0,12" />
                    <TextBlock Text="Tùy chọn hiển thị" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <CheckBox Content="Ghi nhớ lựa chọn lần sau" IsChecked="True" Margin="0,0,0,8" />
                    <CheckBox Content="Hiển thị thông báo cập nhật" IsChecked="True" Margin="0,0,0,8" />
                    <TextBlock Text="Lệnh gần đây" FontWeight="SemiBold" Margin="0,8,0,8" />
                    <ListBox Style="{StaticResource Command}" MaxHeight="140">
                        <ListBoxItem Content="Tạo dự án mới" />
                        <ListBoxItem Content="Nhập cấu hình" />
                        <ListBoxItem Content="Kiểm tra cập nhật" />
                        <ListBoxItem Content="Mở trợ giúp" />
                    </ListBox>
                </StackPanel>
            </Border>

            <Border x:Name="MenusSection" Width="430" Padding="12" Margin="0,0,12,12" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Trình đơn ngữ cảnh / Trình đơn thả xuống / Thanh trình đơn" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Button Content="Mở trình đơn thả xuống" Style="{StaticResource ButtonOutline}"
                            HorizontalAlignment="Left" Click="OpenDropdown_Click">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource DropdownMenu}">
                                <MenuItem Header="Chỉnh sửa" />
                                <MenuItem Header="Tạo bản sao" />
                                <Separator />
                                <MenuItem Header="Xóa" />
                            </ContextMenu>
