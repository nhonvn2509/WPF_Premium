<UserControl x:Class="WPF_Premium_Demo.ButtonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="24,24,24,24">
            <TextBlock Text="Nút" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Các loại nút bấm với nhiều kiểu dáng và trạng thái khác nhau."
                       FontSize="14" Foreground="{DynamicResource MutedForegroundBrush}"
                       Margin="0,8,0,24" TextWrapping="Wrap" MaxWidth="700" />

            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Các biến thể nút" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <WrapPanel>
                        <Button Content="Chính" Margin="0,0,12,12" Padding="16,8" />
                        <Button Content="Phụ" Style="{StaticResource ButtonSecondary}" Margin="0,0,12,12" Padding="16,8" />
                        <Button Content="Viền" Style="{StaticResource ButtonOutline}" Margin="0,0,12,12" Padding="16,8" />
                        <Button Content="Trong suốt" Style="{StaticResource ButtonGhost}" Margin="0,0,12,12" Padding="16,8" />
                        <Button Content="Nguy hiểm" Style="{StaticResource ButtonDestructive}" Margin="0,0,12,12" Padding="16,8" />
                        <Button Content="Liên kết" Style="{StaticResource ButtonLink}" Margin="0,0,12,12" Padding="16,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Nút với biểu tượng" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <WrapPanel>
                        <Button Margin="0,0,12,12" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Check" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Lưu" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ButtonSecondary}" Margin="0,0,12,12" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ContentCopy" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Sao chép" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ButtonOutline}" Margin="0,0,12,12" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ContentSaveOutline" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Lưu dưới" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Nhóm nút" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <StackPanel Style="{StaticResource ButtonGroup}" Margin="0,0,0,12">
                        <Button Content="Trái" Style="{StaticResource ButtonOutline}" />
                        <Button Content="Giữa" Style="{StaticResource ButtonOutline}" />
                        <Button Content="Phải" Style="{StaticResource ButtonOutline}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ButtonGroup}" Orientation="Horizontal">
                        <Button Content="1" Style="{StaticResource ButtonOutline}" Width="36" />
                        <Button Content="2" Style="{StaticResource ButtonOutline}" Width="36" />
                        <Button Content="3" Style="{StaticResource ButtonOutline}" Width="36" />
                        <Button Content="..." Style="{StaticResource ButtonOutline}" Width="36" />
                        <Button Content="10" Style="{StaticResource ButtonOutline}" Width="36" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Trạng thái" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <WrapPanel>
                        <Button Content="Bình thường" Margin="0,0,12,12" Padding="16,8" />
                        <Button Content="Đang tải" IsEnabled="False" Margin="0,0,12,12" Padding="16,8" />
                        <Button Content="Đã tắt" IsEnabled="False" Margin="0,0,12,12" Padding="16,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="24">
                <StackPanel>
                    <TextBlock Text="Kích thước" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <WrapPanel>
                        <Button Content="Nhỏ" Padding="12,4" FontSize="11" Margin="0,0,12,12" />
                        <Button Content="Mặc định" Padding="16,8" Margin="0,0,12,12" />
                        <Button Content="Lớn" Padding="24,12" FontSize="15" Margin="0,0,12,12" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>